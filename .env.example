# Copy this file to ".env" and fill in your own values for local development.
# In production (Render), set these as environment variables in the dashboard.

SECRET_KEY=change-this-to-a-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Leave empty to use SQLite locally.
# Render will automatically provide DATABASE_URL pointing to PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
